{
  "name": "wdm/woocommerce-delivery-management",
  "description": "Foundation for a maintainable WooCommerce delivery and logistics management plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4 <9.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "1.3",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "WDM\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WDM\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon",
    "phpcs": "@php vendor/bin/phpcs --standard=phpcs.xml.dist",
    "check": [
      "@test",
      "@phpstan",
      "@phpcs"
    ]
  }
}
